# Database
DATABASE_URL=postgres://pamawas:pamawas@localhost:5432/pamawas?sslmode=disable

# Server
PORT=8080
LOG_LEVEL=info
ENVIRONMENT=development

# Delivery Channels
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Report
REPORT_TEMPLATE=
REPORT_INTERVAL=1h
REPORTER_MODE=auto

# Prometheus (optional - for evidence enrichment)
PROMETHEUS_URL=
PROMETHEUS_QUERY_TEMPLATE={incident="%s"}
PROMETHEUS_TIMEOUT=30

# Loki (optional - for evidence enrichment)
LOKI_URL=
LOKI_QUERY_TEMPLATE={incident="%s"}
LOKI_TIMEOUT=30
LOKI_MAX_LINES=100